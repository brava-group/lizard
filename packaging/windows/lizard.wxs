<?xml version="1.0" encoding="utf-8"?>
<!--
  Lizard MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build lizard.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc lizard.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -d HasCli=1 -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\Lizard by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch Lizard" box. Installs a Start Menu shortcut, makes
  Lizard the owner of `.lizard`, and offers it under "Open with" for SVG, PNG and JPEG
  (without taking over the user's default app for them), plus lizard-cli when HasCli=1.
  `msiexec /qn` still installs silently.

  UpgradeCode is fixed for Lizard forever (generated once; never reuse another app's).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Lizard"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="7F8B9827-D065-41B7-A514-2A454B21F484"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Lizard interface design and prototyping tool" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Lizard is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="LizardIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LizardIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/lizard" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/lizard" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Lizard" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by LizardApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Lizard" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Lizard" Level="1">
      <ComponentGroupRef Id="LizardFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLizard"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through lizard.en-us.wxl. -->
    <Property Id="LizardVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Lizard $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Lizard" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#LizardExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchLizard" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="LizardFiles" Directory="INSTALLFOLDER">
      <Component Id="LizardApp" Guid="238228C3-4C1D-4B33-8C5D-C31B65BC2DA4">
        <File Id="LizardExe" Source="$(var.BinDir)\lizard.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Lizard"
              Description="Lizard interface design and prototyping" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LizardIcon.exe" IconIndex="0" />
        </File>
        <File Id="LizardNotice" Source="$(var.BinDir)\NOTICE" />
        <File Id="LizardAttribution" Source="$(var.BinDir)\ATTRIBUTION.md" />
        <File Id="LizardLegibleNextLicense" Source="$(var.BinDir)\OFL-NV-Legible-Next.txt" />

        <!-- .lizard: Lizard's own format; Lizard is its default app. -->
        <ProgId Id="Lizard.Document" Description="Lizard Document" Icon="LizardExe" IconIndex="0">
          <Extension Id="lizard" ContentType="application/x-lizard">
            <Verb Id="open" Command="Open" TargetFile="LizardExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- SVG and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Lizard.Image" Description="Image" Icon="LizardExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Lizard.Image\shell\open\command" Value="&quot;[#LizardExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.svg\OpenWithProgids" Name="Lizard.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="Lizard.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="Lizard.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Lizard.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "lizard"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\lizard.exe" Name="FriendlyAppName" Value="Lizard" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\lizard.exe\shell\open\command" Value="&quot;[#LizardExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\lizard.exe\SupportedTypes" Name=".lizard" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\lizard.exe\SupportedTypes" Name=".svg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\lizard.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\lizard.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\lizard.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\lizard.exe" Value="[#LizardExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Lizard" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="LizardCli">
        <File Id="LizardCliExe" Source="$(var.BinDir)\lizard-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
