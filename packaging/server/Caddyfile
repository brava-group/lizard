# Caddy in front of lizard-server; setup in docs/server.md ("Deploy on a Linux server").
# Replace the host name with yours (its DNS must point at this machine). Caddy obtains and renews
# the certificate and passes WebSocket upgrades through by itself. Put this in /etc/caddy/Caddyfile
# and run `sudo systemctl reload caddy`.
# Caddy tells the server who each client is (X-Forwarded-For): set trusted_proxy = "127.0.0.1" in
# server.toml so per-address limits and blocks count clients, not Caddy.

design.example.com {
	reverse_proxy 127.0.0.1:47900
}

# Under a path of an existing site instead (then public_url = "wss://example.com/lizard/"):
#
# example.com {
# 	handle /lizard/* {
# 		reverse_proxy 127.0.0.1:47900
# 	}
# }
